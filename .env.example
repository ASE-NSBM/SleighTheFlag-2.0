# ─────────────────────────────────────────────────────────────
#  Sleigh The Flag 2.0 — environment
#  Copy to .env.local (development) or set these on your host.
# ─────────────────────────────────────────────────────────────

# Admin panel login (/admin). The panel stays locked until ADMIN_PASSWORD
# is set to something with at least 8 characters. Use a long random one:
#   openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie. When empty it is derived from the
# password (so changing the password signs everyone out).
#   openssl rand -hex 32
SESSION_SECRET=

# Public URL of the site — used for social share cards.
# On Vercel you can leave this out: it defaults to the project's production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database.
# Leave empty to use a local SQLite file at ./data/sleigh-the-flag.db
# (fine for `npm run dev`, a VPS or a Docker volume).
# On serverless hosts (Vercel, Netlify…) the disk is NOT persistent, so a
# hosted Turso database is REQUIRED there:
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=...
# Adding Turso from Vercel's Storage tab sets TURSO_DATABASE_URL and
# TURSO_AUTH_TOKEN instead — the app reads those names as well.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
